    </item>
    <item android:top="22dp" android:bottom="22dp" android:left="12dp" android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="#00C9DB" />
        </shape>
    </item>
    <item android:top="34dp" android:bottom="34dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
            <solid android:color="#0A0F1E" />
        </shape>
    </item>
</layer-list>
